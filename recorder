-- rtd/recorder - Retro Tower Defense Macro Recorder
-- Captures player actions during a match and outputs a TDS-style strategy file

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local ByteNet = require(ReplicatedStorage.Teawork.Shared.Services.ByteNetworking)
local TimescaleUpdater = require(ReplicatedStorage.Teawork.Shared.Modules.TimescaleUpdater)

local recorder = {}
local isRecording = false
local outputLines = {}
local currentWave = 0
local towerIndexByUID = {}
local nextTowerIndex = 1
local hooks = {}

--- Helpers

function recorder:GetTimescale()
    return ReplicatedStorage.RoundInfo:GetAttribute("Timescale") or 1
end

function recorder:GetGameTime()
    return TimescaleUpdater:GetTime()
end

--- Write wave section header

local function WriteWaveHeader(wave)
    table.insert(outputLines, "")
    table.insert(outputLines, string.format("-- [ Wave %d ] --", wave))
    table.insert(outputLines, "")
end

--- Hook installation

local function InstallHooks()
    -- Track tower creation to map UIDs to sequential indices
    local onCreateTowers = ByteNet.Towers.CreateTowers.listen(function(data)
        if data and data.Towers then
            for _, tower in ipairs(data.Towers) do
                local uid = tower.ID or tower.UID
                local name = tower.Name or tower.ItemID
                if uid and not towerIndexByUID[uid] then
                    towerIndexByUID[uid] = nextTowerIndex
                    nextTowerIndex = nextTowerIndex + 1
                end
            end
        end
    end)
    table.insert(hooks, onCreateTowers)

    -- Track PlaceTower invocations
    local origPlace = ByteNet.Towers.PlaceTower.invoke
    ByteNet.Towers.PlaceTower.invoke = function(args)
        local result = origPlace(args)
        local name = args.TowerID
        local pos = args.Position
        table.insert(outputLines, string.format("api:Place(\"%s\", %.1f, %.1f, %.1f)", name, pos.X, pos.Y, pos.Z))
        -- UID will be mapped by CreateTowers packet hook above
        return result
    end
    table.insert(hooks, {
        Disconnect = function()
            ByteNet.Towers.PlaceTower.invoke = origPlace
        end
    })

    -- Track UpgradeTower invocations
    local origUpgrade = ByteNet.Towers.UpgradeTower.invoke
    ByteNet.Towers.UpgradeTower.invoke = function(args)
        local result = origUpgrade(args)
        local uid = args.TowerUID
        local idx = towerIndexByUID[uid]
        if idx then
            table.insert(outputLines, string.format("api:Upgrade(%d)", idx))
        end
        return result
    end
    table.insert(hooks, {
        Disconnect = function()
            ByteNet.Towers.UpgradeTower.invoke = origUpgrade
        end
    })

    -- Track VoteSkip
    local origVoteSkip = ByteNet.MatchmakingNew.VoteSkip.invoke
    ByteNet.MatchmakingNew.VoteSkip.invoke = function(args)
        local result = origVoteSkip(args)
        table.insert(outputLines, string.format("api:VoteSkip(%d)", args.Wave))
        return result
    end
    table.insert(hooks, {
        Disconnect = function()
            ByteNet.MatchmakingNew.VoteSkip.invoke = origVoteSkip
        end
    })

    -- Track Ready
    local origReady = ByteNet.MatchmakingNew.Ready.invoke
    ByteNet.MatchmakingNew.Ready.invoke = function(args)
        local result = origReady(args)
        table.insert(outputLines, "api:Ready()")
        return result
    end
    table.insert(hooks, {
        Disconnect = function()
            ByteNet.MatchmakingNew.Ready.invoke = origReady
        end
    })

    -- Track DifficultyVote.Vote.send for Mode
    local origMode = ByteNet.DifficultyVote.Vote.send
    ByteNet.DifficultyVote.Vote.send = function(difficulty)
        origMode(difficulty)
        table.insert(outputLines, string.format("api:Mode(\"%s\")", difficulty))
    end
    table.insert(hooks, {
        Disconnect = function()
            ByteNet.DifficultyVote.Vote.send = origMode
        end
    })

    -- Track CreateSingleplayer for GameInfo
    local origCreate = ByteNet.MatchmakingNew.CreateSingleplayer.invoke
    ByteNet.MatchmakingNew.CreateSingleplayer.invoke = function(args)
        local result = origCreate(args)
        local modifiersStr = "{}"
        if args.Modifiers and #args.Modifiers > 0 then
            modifiersStr = "{" .. table.concat(args.Modifiers, ", ") .. "}"
        end
        table.insert(outputLines, string.format("api:GameInfo(\"%s\", \"%s\", %s)", args.MapID, args.GameType or "Standard", modifiersStr))
        return result
    end
    table.insert(hooks, {
        Disconnect = function()
            ByteNet.MatchmakingNew.CreateSingleplayer.invoke = origCreate
        end
    })

    -- Track wave changes via ReplicatedStorage attribute
    local roundInfo = ReplicatedStorage:FindFirstChild("RoundInfo")
    if roundInfo then
        local waveConn = roundInfo:GetAttributeChangedSignal("Wave"):Connect(function()
            local newWave = roundInfo:GetAttribute("Wave") or 0
            if newWave > currentWave then
                currentWave = newWave
                WriteWaveHeader(currentWave)
            end
        end)
        table.insert(hooks, waveConn)
    end
end

local function CleanupHooks()
    for _, hook in ipairs(hooks) do
        pcall(function()
            if type(hook) == "table" and hook.Disconnect then
                hook:Disconnect()
            elseif type(hook) == "function" then
                hook:Disconnect()
            else
                hook:Disconnect()
            end
        end)
    end
    hooks = {}
end

--- Main record function - call this from your button/signal

function recorder:Start(stratName)
    if isRecording then return end
    isRecording = true
    outputLines = {}
    currentWave = 0
    towerIndexByUID = {}
    nextTowerIndex = 1

    -- Write header
    table.insert(outputLines, string.format("-- Strategy: %s", stratName or "Untitled"))
    table.insert(outputLines, string.format("-- Recorded: %s", os.date("%Y-%m-%d %H:%M:%S")))
    table.insert(outputLines, "")

    InstallHooks()
end

function recorder:Stop()
    if not isRecording then return end
    isRecording = false
    CleanupHooks()
    -- also stop any EquipTower/EquipSkins tracking for Loadout
end

function recorder:Save(filename)
    local name = filename or ("Strat_" .. os.time())
    local content = table.concat(outputLines, "\n")
    writefile(name .. ".txt", content)
    return name .. ".txt"
end

function recorder:GetOutput()
    return table.concat(outputLines, "\n")
end

-- Record setup actions (called before match starts, in lobby)
function recorder:RecordLoadout(...)
    local towers = {...}
    table.insert(outputLines, string.format("api:Loadout(\"%s\")", table.concat(towers, "\", \"")))
end

function recorder:RecordMode(difficulty)
    table.insert(outputLines, string.format("api:Mode(\"%s\")", difficulty))
end

function recorder:RecordGameInfo(map, gameType, modifiers)
    local modStr = "{}"
    if modifiers and #modifiers > 0 then
        modStr = "{" .. table.concat(modifiers, ", ") .. "}"
    end
    table.insert(outputLines, string.format("api:GameInfo(\"%s\", \"%s\", %s)", map, gameType or "Standard", modStr))
end

return recorder
