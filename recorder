local ByteNet = require(sharedd.Services.ByteNetworking)
local TowersNet = ByteNet.Towers
local SkipNet = ByteNet.SkipWave
local ReadyNet = ByteNet.ReadyVote
local RoundNet = ByteNet.RoundResult

-- Better timer (sync with server if possible)
local startTime = os.time()
task.spawn(function()
    while true do
        env.timer = os.time() - startTime
        task.wait(0.1)
    end
end)

-- Enhanced logging + file append
local function safeAppend(content: string)
    pcall(function()
        appendfile(pathfolder .. env.StratName .. ".txt", content)
    end)
end

-- Hooks (expanded)
hooks.place = hookfunction(TowersNet.PlaceTower.invoke, function(data)
    if checkcaller() then return hooks.place(data) end
    log(`Placed {data.TowerID} @ {data.Position}`)
    safeAppend(`\t api:Place('{data.TowerID}', Vector3.new({data.Position.X},{data.Position.Y},{data.Position.Z}), Vector3.new({data.UpVector.X},{data.UpVector.Y},{data.UpVector.Z}), {env.timer}, {env.wave})\n`)
    return hooks.place(data)
end)

-- Add more hooks from dumps (examples)
hooks.triggerAction = hookfunction(TowersNet.TriggerAction.invoke, function(data) -- e.g. abilities
    if checkcaller() then return hooks.triggerAction(data) end
    log(`Trigger Action on UID {data}`)
    safeAppend(`\t api:TriggerAction({data}, {env.timer}, {env.wave})\n`)
    return hooks.triggerAction(data)
end)

-- Round end / restart
RoundNet.Show.listen(function(data)
    log("Round Ended")
    safeAppend(`\t api:PlayAgain()\nend)\n`)  -- close the Loop
end)

-- Add difficulty, map modifiers, etc. at start
safeAppend(`\t api:Difficulty('{mapinfo:GetAttribute("Difficulty")}')\n`)
