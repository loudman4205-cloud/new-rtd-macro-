-- State
local recordingStartTime = 0
local updateConnection = nil

-- Status update helper
local function SetStatus(text, color)
    statusLabel.Text = text
    statusDot.BackgroundColor3 = color
end

-- Start recording
startBtn.MouseButton1Click:Connect(function()
    if recorder.IsRecording then return end

    local name = nameBox.Text
    if name == "" then
        name = "Strat_" .. os.time()
    end

    recorder:Start(name)
    recordingStartTime = tick()
    SetStatus("Recording...", Color3.fromRGB(50, 255, 80))

    -- Animate recording dot
    if updateConnection then
        updateConnection:Disconnect()
    end
    updateConnection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - recordingStartTime
        local mins = math.floor(elapsed / 60)
        local secs = math.floor(elapsed % 60)
        infoLabel.Text = string.format("Time: %02d:%02d | Actions: %d", mins, secs, #recorder:GetOutput():split("\n"))
    end)

    startBtn.Text = "Recording..."
    startBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    startBtn.Active = false
    stopBtn.Active = true
    stopBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
end)

-- Stop recording
stopBtn.MouseButton1Click:Connect(function()
    if not recorder.IsRecording then return end

    recorder:Stop()
    SetStatus("Idle", Color3.fromRGB(100, 100, 100))

    if updateConnection then
        updateConnection:Disconnect()
        updateConnection = nil
    end

    local filename = recorder:Save(nameBox.Text ~= "" and nameBox.Text or nil)
    infoLabel.Text = "Saved: " .. filename

    startBtn.Text = "Start"
    startBtn.BackgroundColor3 = Color3.fromRGB(50, 160, 80)
    startBtn.Active = true
    stopBtn.Active = false
    stopBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
end)

-- Hotkey toggle (F2 to show/hide)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F2 then
        gui.Enabled = not gui.Enabled
    end
end)

-- Setup lobby recording support
-- In lobby, offer quick-record for Loadout/GameInfo setup
if require(ReplicatedStorage.Teawork.Shared.Modules.PlaceIds).IsLobbyPlace then
    -- Auto-detect loadout changes in lobby
    local origEquip = ByteNet.Inventory.EquipTower.invoke
    ByteNet.Inventory.EquipTower.invoke = function(args)
        local result = origEquip(args)
        -- This runs during recording too, so only capture when recording
        return result
    end

    infoLabel.Text = "In lobby — use Start once in-game"
end

