local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local library = loadstring(game:HttpGet('https://raw.githubusercontent.com/ovoch228/depthsoimgui/refs/heads/main/library'))()

local Teawork = ReplicatedStorage:WaitForChild("Teawork")
local ByteNet = require(Teawork.Shared.Services.ByteNetworking)

local api = {}
local env = getgenv()

env.StratName = "Strat"
env.timer = 0
env.wave = 1
env.isRoundOver = false
env.totalPlaced = 0
env.firstTowerIndex = 1

local mapinfo = ReplicatedStorage.RoundInfo
local roundResult = Players.LocalPlayer.PlayerGui.GameUI.RoundResult

-- Timing
task.spawn(function()
    local start = os.time()
    while true do
        env.timer = (os.time() - start) * 2
        task.wait(0.15)
    end
end)

mapinfo:GetAttributeChangedSignal("Wave"):Connect(function()
    env.wave = mapinfo:GetAttribute("Wave") or 1
end)

roundResult:GetPropertyChangedSignal("Visible"):Connect(function()
    env.isRoundOver = roundResult.Visible
end)

local function waitFor(time: number, wave: number)
    while env.wave < wave and not env.isRoundOver do
        task.wait(0.05)
    end
    while env.timer < time and not env.isRoundOver do
        task.wait(0.05)
    end
    return not env.isRoundOver
end

-- Core API
function api:Loadout(towers: table)
    for i, towerID in towers do
        ByteNet.Inventory.EquipTower.invoke({TowerID = towerID, Slot = i})
        task.wait(0.6)
    end
end

function api:Map(map: string, modifiers: table)
    ByteNet.MatchmakingNew.CreateSingleplayer.invoke({
        MapID = map,
        Modifiers = modifiers or {},
        Gamemode = "Standard"
    })
end

function api:Difficulty(diff: string)
    ByteNet.DifficultyVote.Vote.send(diff)
end

function api:Start()
    ByteNet.Timescale.SetTimescale.send(2)
end

function api:Ready(time: number, wave: number)
    if waitFor(time, wave) then
        ByteNet.ReadyVote.Vote.send(true)
    end
end

function api:Skip(time: number, wave: number)
    if waitFor(time, wave) then
        ByteNet.SkipWave.Vote.send(true)  -- prefer proper packet over raw buffer
    end
end

function api:AutoSkip(enabled: boolean, time: number, wave: number)
    if waitFor(time, wave) then
        ByteNet.SkipWave.ToggleAutoSkip.send(enabled)
    end
end

function api:Place(towerID: string, position: Vector3, upVector: Vector3, time: number, wave: number)
    if waitFor(time, wave) then
        env.totalPlaced += 1
        ByteNet.Towers.PlaceTower.invoke({
            TowerID = towerID,
            Position = position,
            UpVector = upVector,
            Rotation = 0
        })
    end
end

function api:Upgrade(index: number, time: number, wave: number)
    if waitFor(time, wave) then
        local realIndex = env.firstTowerIndex + (index - 1)
        ByteNet.Towers.UpgradeTower.invoke(realIndex)
    end
end

function api:SetTarget(uid: number, mode: string, time: number, wave: number)
    if waitFor(time, wave) then
        local realUID = env.firstTowerIndex + (uid - 1)
        ByteNet.Towers.SetTargetMode.send({UID = realUID, TargetMode = mode})
    end
end

function api:Sell(index: number, time: number, wave: number)
    if waitFor(time, wave) then
        local realIndex = env.firstTowerIndex + (index - 1)
        ByteNet.Towers.SellTower.invoke(realIndex)
    end
end

function api:PlayAgain()
    while not env.isRoundOver do task.wait(0.1) end
    env.firstTowerIndex = env.totalPlaced + 1
    env.timer = 0
    ByteNet.RoundResult.VoteForRestart.send(true)
end

function api:Loop(func)
    while task.wait(0.03) do
        func()
    end
end

return api
